
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Validate') {
            steps {
                script {
                    if (!fileExists('index.html')) {
                        error 'index.html not found!'
                    }
                }
                echo 'Application validation successful.'
            }
        }

        stage('Deploy') {
            steps {
                powershell '''
                    $deployDir = "$env:WORKSPACE\\deployment"

                    New-Item -ItemType Directory -Path $deployDir -Force
                    Copy-Item "$env:WORKSPACE\\index.html" "$deployDir\\index.html" -Force

                    Write-Output "Deployment completed successfully."
                '''
            }
        }

        stage('Verify') {
            steps {
                powershell '''
                    $file = "$env:WORKSPACE\\deployment\\index.html"

                    if (!(Test-Path $file)) {
                        throw "Deployed index.html not found!"
                    }

                    $content = Get-Content $file -Raw

                    if ($content -notmatch "Continuous Deployment with Jenkins") {
                        throw "Deployed HTML content verification failed!"
                    }

                    Write-Output "Deployment verification successful."
                '''
            }
        }
    }

    post {
        success {
            echo 'CD pipeline completed successfully.'
        }
        failure {
            echo 'CD pipeline failed. Check the console output.'
        }
    }
}
